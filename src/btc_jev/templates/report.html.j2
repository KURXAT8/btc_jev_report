<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ subject }}</title></head><body style="margin:0;background:#f1f5f9;color:#172033;font-family:Arial,sans-serif;line-height:1.7"><main style="max-width:820px;margin:auto;padding:24px"><h1 style="font-size:24px;color:#16365a">{{ subject }}</h1>{% for section in sections %}<section style="background:white;padding:20px;margin:16px 0;border-radius:10px;border-top:3px solid #d99923"><h2 style="font-size:18px;margin-top:0">{{ section.title }}</h2>{% for line in section.lines %}<p style="overflow-wrap:anywhere;margin:8px 0">{{ line }}</p>{% endfor %}</section>{% endfor %}</main></body></html>
